{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["jest", "node"],
    "paths": {
      "@yaar/shared": ["./shims/yaar-shared.ts"],
      "@yaar/shared/schemas": ["../../packages/shared/src/schemas.ts"],
      "zod": ["./node_modules/zod"],
      "zod/*": ["./node_modules/zod/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../../packages/shared/src/**/*.ts"],
  "exclude": ["node_modules", "dist", "../../packages/shared/test"]
}
