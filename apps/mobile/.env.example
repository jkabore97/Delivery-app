# URL de l'API Yaar (sans slash final).
# - Émulateur Android : http://10.0.2.2:3000
# - Téléphone réel sur le même Wi-Fi : http://<IP-de-votre-PC>:3000
# - Simulateur iOS / web : http://localhost:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Clé Google Maps SDK for Android (Google Cloud Console > API « Maps SDK for Android »).
# Nécessaire pour afficher les cartes dans un build Android (APK/AAB, development build).
# Laisser vide en développement avec Expo Go. Ne jamais committer la vraie clé.
GOOGLE_MAPS_API_KEY=

# Style de carte de la version web (MapLibre). Par défaut : OpenFreeMap « positron », gratuit et sans clé.
# Si le style ne se charge pas (hôte injoignable) en 6 s, l'application passe à un style de secours embarqué.
# EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Style sombre (offre de course du livreur). Par défaut : OpenFreeMap « dark ».
# EXPO_PUBLIC_MAP_STYLE_DARK_URL=https://tiles.openfreemap.org/styles/dark
