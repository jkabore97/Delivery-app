{
  "name": "@yaar/console",
  "version": "0.1.0",
  "private": true,
  "description": "Console web des contrôleurs Yaar Livraison (React + Vite + MapLibre GL)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
