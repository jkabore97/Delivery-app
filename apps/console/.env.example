# URL de l'API Yaar Livraison (REST + Socket.IO)
VITE_API_URL=http://localhost:3000

# Facultatif : style MapLibre des cartes (défaut : OpenFreeMap « positron », gratuit, sans clé). Sans réponse du
# style après 6 s, les cartes passent à un fond de secours embarqué (marqueurs et itinéraires toujours affichés).
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Mention des données à afficher avec un autre style (défaut : OpenFreeMap / OpenMapTiles / OpenStreetMap).
# VITE_MAP_ATTRIBUTION=© OpenFreeMap © OpenMapTiles © contributeurs OpenStreetMap
