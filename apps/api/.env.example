# Copier en .env et adapter. Ne jamais committer le fichier .env.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL (cf. README : serveur local sur le port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/yaar_dev?schema=public
# URL directe (sans pooler) pour les migrations et le seed du build Vercel ; Neon la fournit.
# Vide = DATABASE_URL est utilisée.
DATABASE_URL_UNPOOLED=
# Base utilisée par `npm test` (elle est vidée à chaque exécution)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/yaar_test?schema=public

# JWT : mettre une longue valeur aléatoire en production (openssl rand -hex 32)
JWT_SECRET=change-me-dev-secret-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=604800

# OTP : avec OTP_PROVIDER=console, le code est affiché dans les logs ;
# avec OTP_DEV_BYPASS=true, le code 123456 est toujours accepté (jamais en production, sauf DEMO_MODE).
OTP_DEV_BYPASS=true
OTP_TTL_SECONDS=300
# Canal d'envoi des codes : console (logs) | whatsapp (emplacement réservé, NON implémenté : l'envoi
# échoue en 503 OTP_PROVIDER_UNAVAILABLE ; cf. src/providers/whatsapp.ts)
OTP_PROVIDER=console

# Mode démonstration (démo publique) : code 123456 accepté pour les clients, vendeurs, livreurs et
# nouveaux comptes, seed de démo autorisé, MÊME avec NODE_ENV=production. Annoncé par GET /config.
# Exige OTP_PROVIDER=console. Jamais avec de vrais utilisateurs.
DEMO_MODE=false
# Mode démonstration : code à 6 chiffres des comptes de console existants (contrôleur, admin), qui
# n'acceptent PAS 123456 (ils voient les pièces KYC). S'utilise après « Recevoir le code », 5 essais par code.
# Obligatoire en production ou sur Vercel (différent de 123456) ; vide en dev/test = 123456.
# Ne jamais le committer ni l'afficher : le communiquer aux partenaires de démonstration à part.
DEMO_STAFF_CODE=
# Build Vercel uniquement (déploiements de production) : données de démonstration si la base n'a encore
# aucun utilisateur (jamais d'effacement). Sans DEMO_MODE=true : ignoré avec un avertissement.
SEED_DEMO=false
# Build Vercel : les prévisualisations (VERCEL_ENV=preview) ne migrent jamais la base ; true pour forcer
# (uniquement avec une base de prévisualisation séparée).
ALLOW_PREVIEW_DB_MIGRATIONS=false

# Stockage des pièces KYC, photos de preuve et photos produits :
# local (disque, STORAGE_DIR) | db (table StoredFile de PostgreSQL, obligatoire sur Vercel).
# Vide = local, ou db sur Vercel.
STORAGE_DRIVER=local
STORAGE_DIR=./storage

# Règles métier
CASH_LIMIT=50000
DISPATCH_RADIUS_KM=5
OFFER_TIMEOUT_SECONDS=30
# Mode socket : période du cycle d'affectation (expiration des offres, relance des commandes)
DISPATCH_TICK_MS=5000
# Un livreur « en ligne » sans position depuis ce délai (minutes) est remis hors ligne
DRIVER_STALE_MINUTES=10

# Temps réel : socket (Socket.IO, serveur persistant) | poll (pas de socket, les applications
# interrogent le REST ; obligatoire sur Vercel). Vide = socket, ou poll sur Vercel.
REALTIME_MODE=socket
# Mode poll : intervalle conseillé aux applications (GET /config), en ms
POLL_INTERVAL_MS=4000
# Mode poll : cycle d'affectation déclenché par les requêtes, au plus une fois par fenêtre (ms,
# toutes instances confondues) ; une requête l'attend au plus WORK_BUDGET_MS
WORK_THROTTLE_MS=4000
WORK_BUDGET_MS=1500

# Tâche quotidienne GET /cron/daily (rétention 12 mois) : Vercel Cron envoie
# « Authorization: Bearer <CRON_SECRET> ». Vide = route refusée. (openssl rand -hex 32)
CRON_SECRET=

# Origines autorisées (CORS) séparées par des virgules ; * pour tout autoriser en dev
# (CORS_ORIGINS=* est refusé quand NODE_ENV=production). Production : URL de la console et de l'app web,
# ex. https://yaar-console.vercel.app,https://yaar-livraison.vercel.app,https://yaar-app-mu.vercel.app
# Motif possible pour les prévisualisations : « * » remplace une partie d'UN segment du nom d'hôte, ex.
# https://yaar-console-*-wendtoin-jairus-kabore-s-projects.vercel.app (jamais https://*.vercel.app).
# Préflights CORS mis en cache 2 h par les navigateurs (Access-Control-Max-Age: 7200).
CORS_ORIGINS=*

# Derrière un reverse proxy (et sur Vercel) : true, ou IP/CIDR des proxys de confiance séparés par des virgules
# (false par défaut : X-Forwarded-For est ignoré, les IP de l'audit ne sont pas falsifiables)
TRUST_PROXY=false

# Limites par IP sur /auth/otp/request et /auth/otp/verify (requêtes / 10 min ; 0 = désactivé)
AUTH_RATE_LIMIT_REQUEST=20
AUTH_RATE_LIMIT_VERIFY=60

# Clé AES-256 (64 caractères hexadécimaux, `openssl rand -hex 32`) pour chiffrer les pièces KYC
# et photos de preuve. Obligatoire en production ; laisser vide en dev = fichiers non chiffrés.
STORAGE_ENCRYPTION_KEY=

LOG_LEVEL=info
