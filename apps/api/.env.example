# Copier en .env et adapter. Ne jamais committer le fichier .env.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL (cf. README : serveur local sur le port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/yaar_dev?schema=public
# Base utilisée par `npm test` (elle est vidée à chaque exécution)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/yaar_test?schema=public

# JWT : mettre une longue valeur aléatoire en production (openssl rand -hex 32)
JWT_SECRET=change-me-dev-secret-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=604800

# OTP : en non-production, le code est affiché dans les logs ;
# avec OTP_DEV_BYPASS=true, le code 123456 est toujours accepté (jamais en production).
OTP_DEV_BYPASS=true
OTP_TTL_SECONDS=300

# Stockage local des pièces KYC et photos de preuve
STORAGE_DIR=./storage

# Règles métier
CASH_LIMIT=50000
DISPATCH_RADIUS_KM=5
OFFER_TIMEOUT_SECONDS=30
DISPATCH_TICK_MS=5000
# Un livreur « en ligne » sans position depuis ce délai (minutes) est remis hors ligne
DRIVER_STALE_MINUTES=10

# Origines autorisées (CORS) séparées par des virgules ; * pour tout autoriser en dev
# (CORS_ORIGINS=* est refusé quand NODE_ENV=production)
CORS_ORIGINS=*

# Derrière un reverse proxy : true, ou IP/CIDR des proxys de confiance séparés par des virgules
# (false par défaut : X-Forwarded-For est ignoré, les IP de l'audit ne sont pas falsifiables)
TRUST_PROXY=false

# Limites par IP sur /auth/otp/request et /auth/otp/verify (requêtes / 10 min ; 0 = désactivé)
AUTH_RATE_LIMIT_REQUEST=20
AUTH_RATE_LIMIT_VERIFY=60

# Clé AES-256 (64 caractères hexadécimaux, `openssl rand -hex 32`) pour chiffrer les pièces KYC
# et photos de preuve. Obligatoire en production ; laisser vide en dev = fichiers non chiffrés.
STORAGE_ENCRYPTION_KEY=

LOG_LEVEL=info
