{
  "name": "@yaar/api",
  "version": "0.1.0",
  "private": true,
  "description": "API Yaar Livraison (Fastify + Prisma + PostgreSQL + Socket.IO)",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:if-empty": "tsx prisma/seed.ts --if-empty",
    "retention": "tsx src/jobs/runRetention.ts",
    "build:vercel": "node scripts/vercel-build.mjs",
    "build:bundle": "node scripts/vercel-build.mjs --skip-db",
    "smoke:vercel": "node scripts/smoke-vercel.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@prisma/client": "^6.19.0",
    "@vercel/functions": "^3.10.6",
    "@yaar/shared": "0.1.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.0",
    "esbuild": "^0.28.2",
    "prisma": "^6.19.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
